{
  "name": "mkstudios-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express and MongoDB Atlas backend for MK Studios",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "frontend:dev": "vite --config vite.config.mjs",
    "frontend:build": "vite build --config vite.config.mjs",
    "frontend:preview": "vite preview --config vite.config.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "vite": "^7.3.7"
  },
  "allowScripts": {
    "esbuild@0.27.7": true
  }
}
