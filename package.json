{
  "name": "mkstudios-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Express and MongoDB Atlas backend for MK Studios",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "dev:all": "concurrently --kill-others --names api,web \"npm:dev\" \"npm:frontend:dev\"",
    "start": "node src/server.js",
    "test": "node --test",
    "seed:catalog": "node scripts/seedCatalog.js",
    "frontend:dev": "vite --config vite.config.mjs",
    "frontend:build": "vite build --config vite.config.mjs",
    "frontend:preview": "vite preview --config vite.config.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.5",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "mongodb-memory-server": "^11.3.0",
    "vite": "^7.3.7"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
